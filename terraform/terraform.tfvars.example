aws_region                     = "eu-central-1"
vpc_cidr_block                 = "10.0.0.0/16"
public_subnet_cidr_block       = "10.0.1.0/24"
public_subnet_b_cidr_block     = "10.0.2.0/24"
public_route_cidr_block        = "0.0.0.0/0"
availability_zone              = "eu-central-1a"
public_availability_zone_b     = "eu-central-1b"
private_subnet_a_cidr_block    = "10.0.11.0/24"
private_subnet_b_cidr_block    = "10.0.12.0/24"
private_availability_zone_a    = "eu-central-1a"
private_availability_zone_b    = "eu-central-1b"
ecr_repository_name            = "internal-api-aws-infra-cicd"
ecr_image_tag_mutability       = "IMMUTABLE"

ecr_image_retention_count      = 3
ecs_cluster_name               = "internal-api-cluster"
ecs_execution_role_name        = "internal-api-ecs-task-execution-role"
ecs_log_group_name             = "/ecs/internal-api"
ecs_log_retention_in_days      = 3
ecs_security_group_name        = "internal-api-ecs"
ecs_security_group_description = "Security group for the internal API ECS tasks."
rds_identifier                 = "internal-api-postgres"
rds_database_name              = "internal_api"
rds_master_username            = "internal_api_admin"
rds_engine_version             = "16.10"
rds_instance_class             = "db.t4g.micro"
rds_allocated_storage          = 20
rds_backup_retention_period    = 1
rds_deletion_protection        = false
rds_skip_final_snapshot        = true
rds_secret_name                = "internal-api/postgresql"
ecs_task_family                = "internal-api"
ecs_container_name             = "internal-api"
ecs_container_port             = 5000
ecs_task_cpu                   = 256
ecs_task_memory                = 512
ecs_image_tag                  = "v1"
ecs_service_name               = "internal-api-service"
ecs_desired_count              = 2
alb_name                       = "api-internal-alb"
monitoring_notification_email  = "alerts@example.com"
grafana_workspace_name         = "internal-api-grafana"
grafana_workspace_role_name    = "internal-api-grafana-workspace"

github_repository_subject      = "repo:OWNER/REPOSITORY:ref:refs/heads/main"
github_actions_role_name       = "internal-api-github-actions"

# Optional temporary SSM bastion and low-rate internal ALB traffic generator.
bastion_enabled                  = false
bastion_name                     = "internal-api-bastion"
bastion_subnet_type               = "private"
bastion_traffic_paths             = ["/health", "/items"]
bastion_traffic_interval_seconds  = 45
bastion_instance_type             = "t3.micro"
bastion_iam_role_name             = "internal-api-bastion"
bastion_security_group_name       = "internal-api-bastion"
