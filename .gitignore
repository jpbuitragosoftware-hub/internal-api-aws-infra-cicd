# Python virtual environments
.venv/
venv/
env/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Python test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.coverage
coverage.xml
htmlcov/

# Local environment and IDE files
.env
.env.*
.vscode/
.idea/

# Terraform local state and working files
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
!terraform/terraform.tfvars
!terraform/terraform.tfvars.example

# Local Terraform overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json
